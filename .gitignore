# =========================
# Dependencies
# =========================
node_modules/
.pnp/
.pnp.js

# =========================
# Build outputs
# =========================
dist/
build/
coverage/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Vite / bundlers
.vite/
.vite-cache/
*.local

# =========================
# Environment / secrets
# =========================
.env
.env.*
!.env.example
!.env.sample

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# OS / Editor
# =========================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

.idea/
*.iml

# =========================
# Git / tooling
# =========================
*.swp
*.swo

# =========================
# Archives / dumps (avoid committing snapshots)
# =========================
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# =========================
# Uploads (depende del proyecto)
# Si "uploads/" es runtime storage, normalmente NO se versiona.
# Si tu app necesita archivos de ejemplo, mejor usa uploads/.gitkeep y una carpeta vacía.
# =========================
uploads/*
!uploads/.gitkeep